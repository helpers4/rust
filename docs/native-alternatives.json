{
  "array": [
    {
      "name": "chunk",
      "libraries": ["itertools", "lodash", "radashi"],
      "native": "<[T]>::chunks(n) / chunks_exact(n)",
      "since": "Rust 1.0 / 1.31",
      "example": "for pair in [1, 2, 3, 4, 5].chunks(2) { /* [1, 2], [3, 4], [5] */ }",
      "notes": "Borrows a slice. helpers4 iter::chunk takes any iterator and owns the items."
    },
    {
      "name": "windows / pairwise",
      "libraries": ["itertools"],
      "native": "<[T]>::windows(n)",
      "since": "Rust 1.0",
      "example": "[1, 2, 3].windows(2)  // [1, 2], [2, 3]"
    },
    {
      "name": "chunk_by / group consecutive",
      "libraries": ["itertools"],
      "native": "<[T]>::chunk_by(pred)",
      "since": "Rust 1.77",
      "example": "[1, 1, 2, 3, 3].chunk_by(|a, b| a == b)",
      "notes": "Groups consecutive equal runs only. helpers4 array::group_by groups by key anywhere."
    },
    {
      "name": "uniq / dedup (consecutive)",
      "libraries": ["itertools", "lodash"],
      "native": "Vec::dedup() / dedup_by_key()",
      "since": "Rust 1.0 / 1.16",
      "example": "let mut v = vec![1, 1, 2]; v.dedup();",
      "notes": "Removes consecutive duplicates in place. helpers4 array::unique removes all duplicates, keeping order."
